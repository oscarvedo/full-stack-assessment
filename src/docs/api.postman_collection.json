  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Wallets",
      "item": [
        {
          "name": "GET /wallets (Consultar saldos de usuario)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "const id = Array.isArray(body) && body.length ? body[0].id : (body.data && body.data[0] && body.data[0].id);",
                  "console.log('walletId =', id, '| HTTP', pm.response.code);",
                  "pm.test('walletId captured (HTTP ' + pm.response.code + ')', function () {",
                  "  pm.expect(id, pm.response.text()).to.be.ok;",
                  "});",
                  "if (id) pm.collectionVariables.set('walletId', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userAuth}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/wallets"
          }
        },
        {
          "name": "GET /wallets/:id/movements (Historial de Ledger)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userAuth}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/wallets/{{walletId}}/movements"
          }
        }
      ]
    },
    {
      "name": "Quotes",
      "item": [
        {
          "name": "POST /quotes (Solicitar cotización comercial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
