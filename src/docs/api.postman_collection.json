          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userAuth}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAmount\": \"5500\"\n}"
            },
            "url": "{{baseUrl}}/quotes"
          }
        }
      ]
    },
    {
      "name": "Exchanges",
      "item": [
        {
          "name": "POST /exchanges (Ejecutar intercambio con Idempotencia)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('dynamicKey', 'key-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "const id = body.id;",
