                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userAuth}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{dynamicKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{quoteId}}\"\n}"
            },
            "url": "{{baseUrl}}/exchanges"
